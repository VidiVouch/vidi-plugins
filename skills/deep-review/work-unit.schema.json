{
  "$comment": "One work unit handed to one fresh worker, by review and rebuild alike. Built and checked by scripts/work_unit.py; references/work-unit.md explains each section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "task",
    "attempt",
    "role",
    "purpose",
    "input",
    "allowed",
    "decisions",
    "contracts",
    "evidence",
    "output",
    "stop"
  ],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "role": {"type": "string", "enum": ["implementer", "verifier"]},
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "acceptance", "mode", "context"],
      "properties": {
        "work": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "mode": {"type": ["string", "null"]},
        "context": {"type": "array", "items": {"type": "string"}}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "head", "indexSha256", "snapshotId", "packetSha256"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "indexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshotId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "allowed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "actions", "forbidden"],
      "properties": {
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared", "dependencies"],
      "properties": {
        "shared": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["state", "summary", "notePath", "verifyNote", "openObligations", "gatedActions"]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "note", "result", "contract"],
      "properties": {
        "dir": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema": {"type": "object", "required": ["required", "properties"]}
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "gates"],
      "properties": {
        "when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["global-settings", "skill-enablement", "paid-calls", "commits-pushes", "hosted-reports"]
          }
        }
      }
    }
  }
}
