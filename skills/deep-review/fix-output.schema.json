{
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition", "summary", "files", "checks", "unresolved", "openObligations", "rebuttals", "escalations"],
  "properties": {
    "disposition": {"type": "string", "enum": ["completed", "partial", "failed"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed"],
        "properties": {
          "command": {"type": "string", "minLength": 1, "maxLength": 500},
          "passed": {"type": "boolean"},
          "note": {"type": "string", "maxLength": 500}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "openObligations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "rebuttals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "note"],
              "properties": {
                "kind": {"type": "string", "enum": ["code", "command", "document"]},
                "ref": {"type": "string", "minLength": 1, "maxLength": 500},
                "note": {"type": "string", "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "reason", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "file": {"type": "string", "minLength": 1, "maxLength": 500},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "note"],
              "properties": {
                "kind": {"type": "string", "enum": ["code", "command", "document"]},
                "ref": {"type": "string", "minLength": 1, "maxLength": 500},
                "note": {"type": "string", "maxLength": 500}
              }
            }
          }
        }
      }
    }
  }
}
