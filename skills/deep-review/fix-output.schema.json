{
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition", "summary", "files", "checks", "unresolved", "openObligations"],
  "properties": {
    "disposition": {"type": "string", "enum": ["completed", "partial", "failed"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed"],
        "properties": {
          "command": {"type": "string", "minLength": 1, "maxLength": 500},
          "passed": {"type": "boolean"},
          "note": {"type": "string", "maxLength": 500}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "openObligations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
